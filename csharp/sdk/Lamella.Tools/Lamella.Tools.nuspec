<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Lamella.Tools.$rid$</id>
    <version>$version$</version>
    <!-- Packing writes here what every package carries: authors, license, licenseUrl, projectUrl, copyright and repository. -->
    <description>The Lamella command-line tool for $rid$. Lamella.Sdk restores and runs it for dotnet build, dotnet publish, and dotnet run. Do not reference this package directly.</description>
    <readme>README.md</readme>
  </metadata>
</package>
