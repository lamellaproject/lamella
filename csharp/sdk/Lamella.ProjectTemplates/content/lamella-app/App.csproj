<Project Sdk="Lamella.Sdk/$version$">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The target framework picks the product: lamella1.0 is Lamella, and net11.0 is Lamella RHU. -->
<!--#if (bothFrameworks) -->
    <TargetFrameworks>net11.0;lamella1.0</TargetFrameworks>
<!--#elif (rhuOnly) -->
    <TargetFramework>net11.0</TargetFramework>
<!--#else -->
    <TargetFramework>lamella1.0</TargetFramework>
<!--#endif -->
<!--#if (lamellaToo) -->
    <!-- This board runs Lamella as well. To build the program for both, list both target frameworks:
    <TargetFrameworks>net11.0;lamella1.0</TargetFrameworks>
    -->
<!--#endif -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <!-- The board dotnet run runs this program on, by its id. With no board named, it runs on this
         computer. -->
<!--#if (hasBoard) -->
    <LamellaTargetBoard>lamella-board-id</LamellaTargetBoard>
<!--#else -->
    <!-- <LamellaTargetBoard>rpi-pico2</LamellaTargetBoard> -->
<!--#endif -->
  </PropertyGroup>

</Project>
