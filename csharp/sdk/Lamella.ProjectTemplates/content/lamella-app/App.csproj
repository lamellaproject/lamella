<Project Sdk="Lamella.Sdk/$version$">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The target framework selects the runtime: `net11.0` targets .NET 11 on Lamella RHU;
      `lamella1.0` targets Lamella's C# runtime (for the smallest microcontrollers). -->
<!--#if (bothFrameworks) -->
    <TargetFrameworks>net11.0;lamella1.0</TargetFrameworks>
<!--#elif (rhuOnly) -->
    <TargetFramework>net11.0</TargetFramework>
<!--#else -->
    <TargetFramework>lamella1.0</TargetFramework>
<!--#endif -->
<!--#if (lamellaToo) -->
    <!-- This board runs Lamella as well. To build the program for both, list both target frameworks:
    <TargetFrameworks>net11.0;lamella1.0</TargetFrameworks>
    -->
<!--#endif -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <!-- The target board specifies the board this program will run on. -->
<!--#if (hasBoard) -->
    <LamellaTargetBoard>lamella-board-id</LamellaTargetBoard>
<!--#else -->
    <!-- <LamellaTargetBoard>raspberrypi-pico-2</LamellaTargetBoard> -->
<!--#endif -->
  </PropertyGroup>

</Project>
