{
  "$schema": "http://json.schemastore.org/template",
  "author": "Lamella LLC",
  "classifications": [ "Lamella", "IoT", "Embedded", "Console" ],
  "identity": "Lamella.App.CSharp",
  "name": "Lamella App",
  "shortName": "lamella-app",
  "description": "A project for creating an application that can run on Lamella on microcontroller boards",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "App",
  "preferNameDirectory": true,
  "symbols": {
    "board": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "Board",
      "description": "The target board for the project.",
      "choices": [
        { "choice": "pimoroni-pico-plus-2", "description": "Pimoroni Pico Plus 2" },
        { "choice": "pimoroni-pico-plus-2-w", "description": "Pimoroni Pico Plus 2 W" },
        { "choice": "raspberrypi-pico-2", "description": "Raspberry Pi Pico 2" },
        { "choice": "raspberrypi-pico-2-w", "description": "Raspberry Pi Pico 2 W" }
      ],
      "replaces": "lamella-board-id"
    },
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "displayName": "Framework",
      "description": "The target framework for the project.",
      "choices": [
        { "choice": "lamella1.0", "description": "Lamella" },
        { "choice": "net11.0", "description": "Lamella RHU" }
      ]
    },
    "hasBoard": {
      "type": "computed",
      "value": "(board != \"\")"
    },
    "lamellaBoard": {
      "type": "computed",
      "value": "(board == \"pimoroni-pico-plus-2\" || board == \"pimoroni-pico-plus-2-w\" || board == \"raspberrypi-pico-2\" || board == \"raspberrypi-pico-2-w\")"
    },
    "rhuBoard": {
      "type": "computed",
      "value": "false"
    },
    "frameworkGiven": {
      "type": "computed",
      "value": "(Framework == lamella1.0 || Framework == net11.0)"
    },
    "wantsRhu": {
      "type": "computed",
      "value": "(Framework == net11.0 || (!frameworkGiven && (!hasBoard || rhuBoard)))"
    },
    "wantsLamella": {
      "type": "computed",
      "value": "(Framework == lamella1.0 || (!frameworkGiven && hasBoard && !rhuBoard))"
    },
    "bothFrameworks": {
      "type": "computed",
      "value": "(wantsRhu && wantsLamella)"
    },
    "rhuOnly": {
      "type": "computed",
      "value": "(wantsRhu && !wantsLamella)"
    },
    "lamellaToo": {
      "type": "computed",
      "value": "(rhuOnly && hasBoard && lamellaBoard)"
    }
  },
  "primaryOutputs": [
    { "path": "App.csproj" }
  ]
}
