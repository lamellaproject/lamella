<!--
  Lamella.Sdk: the MSBuild project SDK for C# programs that run on Lamella.

  A project names it together with its version, <Project Sdk="Lamella.Sdk/VERSION">, and targets
  lamella1.0. This file is imported before the project file. It imports Microsoft.NET.Sdk first, so
  that the dotnet command and editors treat the project as an ordinary .NET project, and then sets
  what a lamella1.0 build needs.
-->
<Project>

  <!-- A reference resolves only from what the project names. The framework folder below holds the
       core library and also every library a project reaches through a PackageReference, so a bare
       assembly name is never looked up there. -->
  <PropertyGroup>
    <AssemblySearchPath_UseTargetFrameworkDirectory>false</AssemblySearchPath_UseTargetFrameworkDirectory>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <!-- This package's version. The lamella tool the build uses has the same version. -->
    <LamellaSdkVersion>$version$</LamellaSdkVersion>
    <LamellaSdkRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</LamellaSdkRoot>

    <!-- Lamella's class library: the core library, the libraries Lamella provides for package
         references, and the builds for a family of chips under families. MSBuild resolves references
         from this folder, and every call to the lamella tool names the same folder in the
         LAMELLA_REF_DIR environment variable, so both read one copy. -->
    <LamellaRefDir>$([MSBuild]::NormalizePath('$(LamellaSdkRoot)', 'ref', 'Lamella', 'v1.0'))</LamellaRefDir>

    <!-- The runtime support archives a program is linked with when the lamella tool writes an image
         for a board: one for each instruction set, or for each board where the archive carries the
         board's own startup, console and clock. They are built from the same sources as the class
         library above, and every call to the lamella tool names this folder in the
         LAMELLA_RUNTIME_SUPPORT_DIR environment variable. -->
    <LamellaRuntimeSupportDir>$([MSBuild]::NormalizePath('$(LamellaSdkRoot)', 'runtime-support'))</LamellaRuntimeSupportDir>

    <!-- The target framework lamella1.0 is Lamella,Version=v1.0, and its reference assemblies are the
         class library above, found through RedistList/FrameworkList.xml beside it. -->
    <BeforeTargetFrameworkInferenceTargets>$(MSBuildThisFileDirectory)Lamella.TargetFramework.targets</BeforeTargetFrameworkInferenceTargets>
    <TargetFrameworkRootPath>$([MSBuild]::NormalizeDirectory('$(LamellaSdkRoot)', 'ref'))</TargetFrameworkRootPath>

    <!-- No .NET framework is referenced: the core library is Lamella's own. -->
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>

    <!-- The attributes these generators write are types Lamella's core library does not define. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <!-- The build writes the program's assembly alone, with no reference assembly beside it. -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

    <!-- A program builds to a .dll, as on .NET. The C# version defaults to 11, the newest that
         Lamella's compiler accepts, so an editor flags what the build would refuse. -->
    <TargetExt>.dll</TargetExt>
    <LangVersion Condition="'$(LangVersion)' == ''">11</LangVersion>
  </PropertyGroup>

</Project>
