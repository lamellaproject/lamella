<!-- The device list and run command supplied to dotnet run. The tool composes complete entries;
     the SDK supplies the project's framework, board and RHU routes, and owns RuntimeIdentifier. -->
<Project>
  <!-- An explicit local run needs no enumeration. This also preserves the local fallback when
       the tool is unavailable, so the build can report the installation failure. -->
  <ItemGroup>
    <_LamellaLocalDevice Include="local" Description="This computer, under Lamella's interpreter" Type="Local" Model="interpreter" />
  </ItemGroup>

  <Target Name="ComputeAvailableDevices" DependsOnTargets="_LamellaComputeAvailableDevices;_LamellaRhuComputeAvailableDevices" Returns="@(_LamellaDevice)" />

  <!-- RHU supplies its routes before the tool composes the list. This target reads package
       metadata; it does not restore, compile, start an emulator or open a device. -->
  <Target Name="_LamellaPrepareRhuDeviceList"
          Condition="'$(TargetFramework)' == 'net11.0' and '$(_LamellaRhuDispatch)' == 'true'">
    <CallTarget Targets="_LamellaRhuRoutes">
      <Output TaskParameter="TargetOutputs" ItemName="_LamellaRhuRouteFound" />
    </CallTarget>
    <ItemGroup>
      <_LamellaRhuRoute Include="@(_LamellaRhuRouteFound)" Condition="'%(Identity)' != 'fault'" />
      <_LamellaDeviceRouteArgument Include="@(_LamellaRhuRoute)">
        <Argument>--route &quot;%(_LamellaRhuRoute.Identity):%(_LamellaRhuRoute.Board):%(_LamellaRhuRoute.Machine):%(_LamellaRhuRoute.Available)&quot;</Argument>
        <Argument Condition="'%(_LamellaRhuRoute.Identity)' == 'probe'">--route &quot;probe:%(_LamellaRhuRoute.Board)&quot;</Argument>
      </_LamellaDeviceRouteArgument>
    </ItemGroup>
    <PropertyGroup>
      <_LamellaRhuRouteFault>@(_LamellaRhuRouteFound->WithMetadataValue('Identity', 'fault')->'%(Text)')</_LamellaRhuRouteFault>
      <_LamellaRhuRouteFaultCode>@(_LamellaRhuRouteFound->WithMetadataValue('Identity', 'fault')->'%(Code)')</_LamellaRhuRouteFaultCode>
    </PropertyGroup>
  </Target>

  <Target Name="_LamellaListAttached" DependsOnTargets="_LamellaToolFault;_LamellaToolExecutable;_LamellaPrepareRhuDeviceList">
    <PropertyGroup>
      <_LamellaListOptions>--framework &quot;$(TargetFramework)&quot;</_LamellaListOptions>
      <_LamellaListOptions Condition="'$(LamellaTargetBoard)' != ''">$(_LamellaListOptions) --board &quot;$(LamellaTargetBoard)&quot;</_LamellaListOptions>
      <_LamellaListOptions Condition="'$(_LamellaRhuEmulatorBoard)' == 'true'">$(_LamellaListOptions) --emulator-board</_LamellaListOptions>
      <_LamellaListOptions Condition="'$(_LamellaRhuBoardFromDevice)' == 'true'">$(_LamellaListOptions) --qualified</_LamellaListOptions>
      <_LamellaListOptions>$(_LamellaListOptions) @(_LamellaDeviceRouteArgument->'%(Argument)', ' ')</_LamellaListOptions>
      <_LamellaListExit>-1</_LamellaListExit>
    </PropertyGroup>
    <MakeDir Condition="'$(_LamellaToolFault)' == ''" Directories="$(_LamellaIntermediateDir)" />
    <Delete Files="$(_LamellaDevicesFile)" />
    <Exec Condition="'$(_LamellaToolFault)' == '' and '$(_LamellaRhuRouteFault)' == ''"
          Command="&quot;$(_LamellaTool)&quot; devices --msbuild &quot;$(_LamellaDevicesFile)&quot; $(_LamellaListOptions)"
          EnvironmentVariables="LAMELLA_REF_DIR=$(LamellaRefDir);LAMELLA_RUNTIME_SUPPORT_DIR=$(LamellaRuntimeSupportDir)"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ConsoleToMSBuild="true"
          EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_LamellaListExit" />
      <Output TaskParameter="ConsoleOutput" ItemName="_LamellaListOutput" />
    </Exec>
    <PropertyGroup Condition="'$(_LamellaListExit)' != '0' and '$(_LamellaListExit)' != '-1'">
      <_LamellaListFailure>@(_LamellaListOutput, '%0A')</_LamellaListFailure>
      <_LamellaListFailure Condition="'$(_LamellaListFailure)' == ''">The device list could not be read (exit code $(_LamellaListExit)).</_LamellaListFailure>
    </PropertyGroup>
    <Warning Condition="'$(_LamellaListFailure)' != ''" Code="LAMSDK0026" Text="$(_LamellaListFailure)" />
    <MSBuild Condition="'$(_LamellaListExit)' == '0' and Exists('$(_LamellaDevicesFile)')"
             Projects="$(_LamellaDevicesFile)" Targets="LamellaDevices"
             Properties="LamellaDevicesStamp=$([System.DateTime]::UtcNow.Ticks)" ContinueOnError="true">
      <Output TaskParameter="TargetOutputs" ItemName="_LamellaFoundDevice" />
    </MSBuild>
    <MSBuild Condition="'$(_LamellaListExit)' == '0' and Exists('$(_LamellaDevicesFile)')"
             Projects="$(_LamellaDevicesFile)" Targets="LamellaBridges"
             Properties="LamellaDevicesStamp=$([System.DateTime]::UtcNow.Ticks)" ContinueOnError="true">
      <Output TaskParameter="TargetOutputs" ItemName="_LamellaFoundBridge" />
    </MSBuild>
    <MSBuild Condition="'$(_LamellaListExit)' == '0' and Exists('$(_LamellaDevicesFile)')"
             Projects="$(_LamellaDevicesFile)" Targets="LamellaUnreachedBoards"
             Properties="LamellaDevicesStamp=$([System.DateTime]::UtcNow.Ticks)" ContinueOnError="true">
      <Output TaskParameter="TargetOutputs" ItemName="_LamellaUnreachedBoard" />
    </MSBuild>
  </Target>

  <Target Name="_LamellaComputeAvailableDevices" DependsOnTargets="_LamellaListAttached"
          Condition="'$(TargetFrameworkIdentifier)' == 'Lamella'">
    <Warning Condition="'$(_LamellaToolFault)' != ''" Code="$(_LamellaToolFaultCode)" Text="$(_LamellaToolFault) No board is listed." />
    <ItemGroup>
      <_LamellaDevice Include="@(_LamellaFoundDevice)" />
      <_LamellaDevice Include="@(_LamellaLocalDevice)" Condition="'$(LamellaTargetBoard)' == '' and '$(_LamellaListExit)' != '0'" />
    </ItemGroup>
    <Warning Condition="'$(LamellaTargetBoard)' != '' and '@(_LamellaDevice)' == '' and '@(_LamellaFoundBridge)' != ''"
             Code="LAMSDK0016"
             Text="A board behind a debug probe is not listed for a project that names a board, because the probe cannot say which board it is. Reach it with dotnet run --device &lt;ID&gt;, where &lt;ID&gt; names the probe's UART bridge: @(_LamellaFoundBridge, ', '). lamella devices lists every device with its ID." />
  </Target>

  <Target Name="_LamellaRhuComputeAvailableDevices" DependsOnTargets="_LamellaListAttached"
          Condition="'$(TargetFramework)' == 'net11.0' and '$(_LamellaRhuDispatch)' == 'true'">
    <Warning Condition="'$(_LamellaToolFault)' != ''" Code="$(_LamellaToolFaultCode)" Text="$(_LamellaToolFault) No device is listed." />
    <Warning Condition="'$(_LamellaRhuRouteFault)' != ''" Code="$(_LamellaRhuRouteFaultCode)" Text="$(_LamellaRhuRouteFault) No device is listed." />
    <ItemGroup>
      <_LamellaDevice Include="@(_LamellaFoundDevice)">
        <RuntimeIdentifier Condition="'$(LamellaTargetBoard)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RuntimeIdentifier>
      </_LamellaDevice>
    </ItemGroup>
    <PropertyGroup>
      <_LamellaRhuUnreached>@(_LamellaUnreachedBoard)</_LamellaRhuUnreached>
      <_LamellaRhuBoardUnreached Condition="'$(LamellaTargetBoard)' != '' and $([System.String]::Copy(';$(_LamellaRhuUnreached);').Contains(';$(LamellaTargetBoard);'))">true</_LamellaRhuBoardUnreached>
    </PropertyGroup>
    <Warning Condition="'$(_LamellaRhuBoardUnreached)' == 'true' and '$(_LamellaRhuBoardFromDevice)' != 'true'" Code="LAMSDK0017" Text="$(LamellaTargetBoard) has no probe route in this SDK yet." />
    <Warning Condition="'$(LamellaTargetBoard)' == '' and '@(_LamellaDevice)' == '' and '$(_LamellaListExit)' == '0'"
             Code="LAMSDK0018"
             Text="This project names no board, and no debug probe or emulator that reaches one of Lamella RHU's boards was found. Attach a debug probe wired to the board, and dotnet run lists it once for each board it reaches; or name the board as LamellaTargetBoard, in the project file or with -p:LamellaTargetBoard=&lt;id&gt; on the dotnet run command line." />
  </Target>

  <!-- Lamella RHU's routes (RhuRunRoutes), or, when RHU's targets cannot be read, one item, fault, whose Text says why.
       dotnet run evaluates a project before it restores it, and on a project's first restore lists its devices from
       that evaluation, which has none of RHU's targets, since they come from a package: the routes then come from a
       fresh evaluation of the project, made once the restore has written its assets file. -->
  <Target Name="_LamellaRhuRoutes" DependsOnTargets="_LamellaRhuFault" Returns="@(_LamellaRhuRouteOrFault)">
    <CallTarget Condition="'$(_LamellaRhuImports)' == 'true'" Targets="RhuRunRoutes">
      <Output TaskParameter="TargetOutputs" ItemName="_LamellaRhuRouteOrFault" />
    </CallTarget>
    <MSBuild Condition="'$(_LamellaRhuImports)' != 'true' and '$(_LamellaRhuRoutesAfterRestore)' != 'true' and Exists('$(ProjectAssetsFile)')"
             Projects="$(MSBuildProjectFullPath)"
             Targets="_LamellaRhuRoutes"
             Properties="_LamellaRhuRoutesAfterRestore=true">
      <Output TaskParameter="TargetOutputs" ItemName="_LamellaRhuRouteOrFault" />
    </MSBuild>
    <ItemGroup Condition="'@(_LamellaRhuRouteOrFault)' == '' and '$(_LamellaRhuImports)' != 'true'">
      <_LamellaRhuRouteOrFault Include="fault" Text="$(_LamellaRhuFault)" Code="$(_LamellaRhuFaultCode)" />
    </ItemGroup>
  </Target>

  <!-- The device list as a person reads it in a refusal, in dotnet run's own form: each id, its
       description, its type and its status; how many devices it holds; and the first id. -->
  <Target Name="_LamellaDeviceListText" DependsOnTargets="ComputeAvailableDevices">
    <ItemGroup>
      <_LamellaListedDevice Include="@(_LamellaDevice)" />
      <_LamellaListedDevice Condition="'%(_LamellaListedDevice.Status)' == ''">
        <LamellaShown>%(_LamellaListedDevice.Type)</LamellaShown>
      </_LamellaListedDevice>
      <_LamellaListedDevice Condition="'%(_LamellaListedDevice.Status)' != ''">
        <LamellaShown>%(_LamellaListedDevice.Type), %(_LamellaListedDevice.Status)</LamellaShown>
      </_LamellaListedDevice>
    </ItemGroup>
    <PropertyGroup>
      <_LamellaDeviceCount>@(_LamellaDevice->Count())</_LamellaDeviceCount>
      <_LamellaDeviceIds>@(_LamellaDevice)</_LamellaDeviceIds>
      <_LamellaFirstDevice>$(_LamellaDeviceIds)</_LamellaFirstDevice>
      <_LamellaFirstDevice Condition="$(_LamellaDeviceIds.Contains(';'))">$(_LamellaDeviceIds.Substring(0, $(_LamellaDeviceIds.IndexOf(';'))))</_LamellaFirstDevice>
      <_LamellaDeviceList>@(_LamellaListedDevice->'  %(Identity) - %(Description) (%(LamellaShown))', '%0A')</_LamellaDeviceList>
      <_LamellaEntryPointFile>$([System.IO.Path]::GetFileName('$(EntryPointFilePath)'))</_LamellaEntryPointFile>
      <_LamellaDeviceOption>the --device argument</_LamellaDeviceOption>
      <_LamellaDeviceOption Condition="'$(FileBasedProgram)' == 'true'">-p:Device=&lt;id&gt;</_LamellaDeviceOption>
      <_LamellaDeviceExample>dotnet run --device $(_LamellaFirstDevice)</_LamellaDeviceExample>
      <_LamellaDeviceExample Condition="'$(FileBasedProgram)' == 'true'">dotnet run $(_LamellaEntryPointFile) -p:Device=$(_LamellaFirstDevice)</_LamellaDeviceExample>
    </PropertyGroup>
  </Target>

  <Target Name="ComputeRunArguments" DependsOnTargets="_LamellaComputeRunArguments;_LamellaRhuComputeRunArguments" />

  <!-- The device a file-based app runs on when none is named. dotnet run chooses no device for a
       file-based app, and does not read its device options for one: only -p:Device= reaches the
       build. So the list is computed here, as ComputeAvailableDevices computes it for a project. A
       lone device is used, as dotnet run uses one; none, or several, is refused in dotnet run's own
       words, naming -p:Device=<id> in place of its option. -->
  <Target Name="_LamellaFileBasedDevice"
          DependsOnTargets="_LamellaDeviceListText"
          Condition="'$(FileBasedProgram)' == 'true' and '$(Device)' == ''">
    <Error Condition="'$(_LamellaListFailure)' != ''" Code="LAMSDK0026" Text="$(_LamellaListFailure)" />
    <Error Condition="'$(_LamellaDeviceCount)' == '0'"
           Code="LAMSDK0019"
           Text="No devices are available for this project. A file-based program names the device it runs on with -p:Device=&lt;id&gt;, since dotnet run takes no --device for it." />
    <Error Condition="'$(_LamellaDeviceCount)' &gt; '1'"
           Code="LAMSDK0020"
           Text="Unable to run this project because multiple devices are available. Please specify which device to use by passing -p:Device=&lt;id&gt; with one of the following values:%0A$(_LamellaDeviceList)%0A%0AExample: $(_LamellaDeviceExample)" />
    <ItemGroup>
      <_LamellaRunDevice Include="@(_LamellaDevice)" />
    </ItemGroup>
  </Target>

  <!-- The device dotnet run was given, which must be one the list holds. dotnet run passes an id it
       does not know straight through as Device, so an id this project cannot run on is refused here,
       with the list, before anything is written to a device. This computer, for a lamella1.0 project
       that names no board, is the list's own first device, and is taken without asking the lamella
       tool. A net11.0 device qualified by the board the project names is that device's unqualified
       id; a probe for a board that has no probe route in this SDK yet is refused in
       those words. -->
  <Target Name="_LamellaNamedDevice" DependsOnTargets="_LamellaNamedLocalDevice;_LamellaNamedListedDevice" />

  <Target Name="_LamellaNamedLocalDevice" Condition="'$(Device)' == 'local' and '$(LamellaTargetBoard)' == '' and '$(TargetFrameworkIdentifier)' == 'Lamella'">
    <ItemGroup>
      <_LamellaRunDevice Include="@(_LamellaLocalDevice)" />
    </ItemGroup>
  </Target>

  <Target Name="_LamellaNamedListedDevice"
          DependsOnTargets="_LamellaDeviceListText"
          Condition="'$(Device)' != '' and !('$(Device)' == 'local' and '$(LamellaTargetBoard)' == '' and '$(TargetFrameworkIdentifier)' == 'Lamella')">
    <PropertyGroup>
      <_LamellaListedId>$(Device)</_LamellaListedId>
      <_LamellaListedId Condition="'$(_LamellaRhuBoardFromDevice)' == 'true' and '$(_LamellaRhuDeviceMachine)' != ''">$(Device)/$(LamellaTargetBoard)</_LamellaListedId>
      <_LamellaListedId Condition="'$(_LamellaRhuDeviceNamesBoard)' != '' and '$(_LamellaRhuDeviceNamesBoard)' == '$(LamellaTargetBoard)'">$([System.Text.RegularExpressions.Regex]::Replace('$(Device)', '/[^/]+$', ''))</_LamellaListedId>
    </PropertyGroup>
    <ItemGroup>
      <_LamellaRunDevice Include="@(_LamellaDevice->WithMetadataValue('Identity', '$(_LamellaListedId)'))" />
    </ItemGroup>
    <!-- A physical board's emulator is not offered in its list. Naming one explicitly still
         selects an available RHU route for that board and machine. -->
    <PropertyGroup Condition="'@(_LamellaRunDevice)' == '' and '$(_LamellaListExit)' == '0' and '$(TargetFramework)' == 'net11.0' and '$(LamellaTargetBoard)' != ''">
      <_LamellaExplicitEmulatorMachine Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_LamellaListedId)', '^(?i:emulator:)[^/]+$'))">$([System.Text.RegularExpressions.Regex]::Replace('$(_LamellaListedId)', '^(?i:emulator:)', ''))</_LamellaExplicitEmulatorMachine>
    </PropertyGroup>
    <ItemGroup Condition="'$(_LamellaExplicitEmulatorMachine)' != ''">
      <_LamellaExplicitEmulatorRoute Include="@(_LamellaRhuRoute)"
          Condition="'%(_LamellaRhuRoute.Identity)' == 'emulator' and '%(_LamellaRhuRoute.Machine)' == '$(_LamellaExplicitEmulatorMachine)' and '%(_LamellaRhuRoute.Available)' == 'true' and ('%(_LamellaRhuRoute.Board)' == '' or '%(_LamellaRhuRoute.Board)' == '$(LamellaTargetBoard)')" />
      <_LamellaRunDevice Include="$(_LamellaListedId)" Condition="'@(_LamellaExplicitEmulatorRoute)' != ''"
          Board="$(LamellaTargetBoard)" Route="emulator" Machine="$(_LamellaExplicitEmulatorMachine)" />
    </ItemGroup>
    <Error Condition="'@(_LamellaRunDevice)' == '' and '$(_LamellaListFailure)' != ''" Code="LAMSDK0026" Text="$(_LamellaListFailure)" />
    <Error Condition="'@(_LamellaRunDevice)' == '' and '$(_LamellaRhuBoardUnreached)' == 'true' and $(Device.ToLowerInvariant().StartsWith('probe:'))"
           Code="LAMSDK0017"
           Text="Unable to run this project on the device '$(Device)', which is not one of its devices: $(LamellaTargetBoard) has no probe route in this SDK yet." />
    <Error Condition="'@(_LamellaRunDevice)' == '' and '$(_LamellaDeviceCount)' == '0'"
           Code="LAMSDK0021"
           Text="Unable to run this project on the device '$(Device)', which is not one of its devices. No devices are available for this project." />
    <Error Condition="'@(_LamellaRunDevice)' == '' and '$(_LamellaDeviceCount)' != '0'"
           Code="LAMSDK0021"
           Text="Unable to run this project on the device '$(Device)', which is not one of its devices. Please specify which device to use by passing $(_LamellaDeviceOption) with one of the following values:%0A$(_LamellaDeviceList)%0A%0AExample: $(_LamellaDeviceExample)" />
  </Target>

  <!-- A run on a debug probe runs the image dotnet publish writes, so the run's build ends in a
       publish: dotnet run names the device it was given as the global property Device for each step
       of the run, the build first and ComputeRunArguments after it, and its no-build option skips the
       build alone. A build that carries a probe's id therefore publishes, natively whatever the
       project's PublishAot, since a probe takes a native image; and a run with the no-build option
       runs the image the last publish left, and is refused by name when there is none. The publish is
       made through the project itself, with the publishing flag that keeps it from publishing again.
       The device is checked first, so that nothing is published for an id the project cannot run on. -->
  <Target Name="_LamellaRunPublish"
          AfterTargets="Build"
          DependsOnTargets="_LamellaNamedDevice"
          Condition="'$(TargetFrameworkIdentifier)' == 'Lamella' and '$(_IsPublishing)' != 'true' and $(Device.ToLowerInvariant().StartsWith('probe:'))">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="_IsPublishing=true;PublishAot=true" />
  </Target>

  <!-- A net11.0 run's build ends in Lamella RHU's own publish, after Build, when dotnet run names a device. The device
       is checked first, here, so that nothing is published for an id the project cannot run on: this file is read
       before RHU's targets, so this target runs before theirs, after Build. -->
  <Target Name="_LamellaRhuRunDevice"
          AfterTargets="Build"
          DependsOnTargets="_LamellaNamedDevice"
          Condition="'$(TargetFramework)' == 'net11.0' and '$(_LamellaRhuDispatch)' == 'true' and '$(_IsPublishing)' != 'true' and '$(Device)' != ''" />

  <!-- The command dotnet run starts, after the build.

       On a debug probe: the lamella tool, given the manifest of the image the run published and the
       probe's USB serial number. It writes the image to the board over the probe, starts the program,
       prints what the program prints, and ends with the program's exit code. A file-based app whose
       lone device is a probe has published nothing yet, since dotnet run named no device to its
       build, so the image is published here first.

       Anywhere else: the lamella tool, given the built assembly, the class library's folder and the
       runtime support archives' folder, and the device dotnet run chose, if any, or for a file-based
       app the lone device; the device local is this computer. The backslashes that end a folder are
       doubled, so that they do not escape the quote that closes it. With a device, the board the
       project names goes too, and the tool sends the program only when the board that answers is
       that one: the device list names each device by its USB identity alone, so it cannot say which
       board is behind a bridge. The tool finds the program's own libraries beside the assembly, where
       the build copies them.

       Either way the bare double dash ends the tool's arguments, so anything dotnet run appends after
       it is the program's. -->
  <Target Name="_LamellaComputeRunArguments"
          DependsOnTargets="_LamellaCheckTool;_LamellaFileBasedDevice;_LamellaNamedDevice"
          Condition="'$(TargetFrameworkIdentifier)' == 'Lamella'">
    <PropertyGroup>
      <_LamellaRunDeviceId>@(_LamellaRunDevice)</_LamellaRunDeviceId>
      <_LamellaRunNative>@(_LamellaRunDevice->WithMetadataValue('Model', 'native')->Count())</_LamellaRunNative>
    </PropertyGroup>
    <MSBuild Condition="'$(_LamellaRunNative)' == '1' and '$(Device)' == ''" Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="_IsPublishing=true;PublishAot=true" />
    <PropertyGroup Condition="'$(_LamellaRunNative)' == '1'">
      <_LamellaRunManifest>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)', '$(AssemblyName).elf.manifest.json'))</_LamellaRunManifest>
      <RunCommand>$(_LamellaTool)</RunCommand>
      <RunArguments>run --manifest &quot;$(_LamellaRunManifest)&quot; --probe &quot;@(_LamellaRunDevice->'%(Serial)')&quot; --</RunArguments>
      <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    </PropertyGroup>
    <Error Condition="'$(_LamellaRunNative)' == '1' and !Exists('$(_LamellaRunManifest)')"
           Code="LAMSDK0022"
           Text="There is no image to run on $(_LamellaRunDeviceId): no manifest at '$(_LamellaRunManifest)'. A run on a debug probe publishes the program and runs the image it writes, and a run with the no-build option publishes nothing; run without it." />
    <PropertyGroup Condition="'$(_LamellaRunNative)' != '1'">
      <_LamellaRunDeviceId Condition="'$(_LamellaRunDeviceId)' == ''">$(Device)</_LamellaRunDeviceId>
      <_LamellaRefDirArgument>$([System.Text.RegularExpressions.Regex]::Replace('$(LamellaRefDir)', '(\\+)$', '$1$1'))</_LamellaRefDirArgument>
      <_LamellaRuntimeSupportDirArgument>$([System.Text.RegularExpressions.Regex]::Replace('$(LamellaRuntimeSupportDir)', '(\\+)$', '$1$1'))</_LamellaRuntimeSupportDirArgument>
      <RunCommand>$(_LamellaTool)</RunCommand>
      <RunArguments>run --built &quot;$(TargetPath)&quot; --ref-dir &quot;$(_LamellaRefDirArgument)&quot; --runtime-support-dir &quot;$(_LamellaRuntimeSupportDirArgument)&quot;</RunArguments>
      <RunArguments Condition="'$(_LamellaRunDeviceId)' != '' and '$(_LamellaRunDeviceId)' != 'local'">$(RunArguments) --device &quot;$(_LamellaRunDeviceId)&quot;</RunArguments>
      <RunArguments Condition="'$(_LamellaRunDeviceId)' != '' and '$(_LamellaRunDeviceId)' != 'local' and '$(LamellaTargetBoard)' != ''">$(RunArguments) --board &quot;$(LamellaTargetBoard)&quot;</RunArguments>
      <RunArguments>$(RunArguments) --</RunArguments>
    </PropertyGroup>
  </Target>

  <!-- The command dotnet run starts for a net11.0 program, after the build and Lamella RHU's publish (the shell
       contract, sections 3.3 and 3.4).

       On a debug probe, the probe route is this SDK's, as for a lamella1.0 program: the lamella tool, given the
       manifest in the publish folder and the probe's USB serial number, then the bare double dash, in the project's
       folder. On an emulator, Lamella RHU composes the command, an executable and its arguments, in its
       RhuComputeRunCommand, handed the route and the emulator's machine as LamellaDeviceRoute and
       LamellaEmulatorMachine; the lamella tool starts that command, so that the run first says how the program runs,
       as it does on a probe.

       A file-based app chooses its device here, as for a lamella1.0 program, and its build named no device, so the
       image is published here first. A device that names a board the project does not name cannot be run that way,
       since the restore brought no package of that board's: the device is named on the command line instead, with
       -p:Device=<id>, which the restore then sees. -->
  <Target Name="_LamellaRhuComputeRunArguments"
          DependsOnTargets="_LamellaRhuRunDeviceChosen;_LamellaRhuProbeRun;_LamellaRhuEmulatorRun"
          Condition="'$(TargetFramework)' == 'net11.0' and '$(_LamellaRhuDispatch)' == 'true'" />

  <Target Name="_LamellaRhuRunDeviceChosen" DependsOnTargets="_LamellaRhuDeviceBoardCheck;_LamellaFileBasedDevice;_LamellaNamedDevice">
    <PropertyGroup>
      <_LamellaRunDeviceId>@(_LamellaRunDevice)</_LamellaRunDeviceId>
      <_LamellaRunRoute>@(_LamellaRunDevice->'%(Route)')</_LamellaRunRoute>
      <_LamellaRunMachine>@(_LamellaRunDevice->'%(Machine)')</_LamellaRunMachine>
      <_LamellaRunBoard>@(_LamellaRunDevice->'%(Board)')</_LamellaRunBoard>
    </PropertyGroup>
    <Error Condition="'$(_LamellaRunDeviceId)' == ''"
           Code="LAMSDK0023"
           Text="A $(TargetFramework) program runs on a device, and none was given. dotnet run chooses one from the project's devices, which dotnet run --list-devices lists." />
    <Error Condition="'$(Device)' == '' and '$(_LamellaRunBoard)' != '$(LamellaTargetBoard)'"
           Code="LAMSDK0024"
           Text="Unable to run this program on the device '$(_LamellaRunDeviceId)', which is for the board $(_LamellaRunBoard), when the program names no board: the board's packages are restored only for a device named before the build. Name it: dotnet run $(_LamellaEntryPointFile) -p:Device=$(_LamellaRunDeviceId)" />
    <MSBuild Condition="'$(Device)' == ''" Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="_IsPublishing=true" />
  </Target>

  <Target Name="_LamellaRhuProbeRun" DependsOnTargets="_LamellaCheckTool" Condition="'$(_LamellaRunRoute)' == 'probe'">
    <PropertyGroup>
      <_LamellaRunManifest>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)', '$(AssemblyName).elf.manifest.json'))</_LamellaRunManifest>
      <RunCommand>$(_LamellaTool)</RunCommand>
      <RunArguments>run --manifest &quot;$(_LamellaRunManifest)&quot; --probe &quot;@(_LamellaRunDevice->'%(Serial)')&quot; --no-banner --</RunArguments>
      <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(_LamellaRunManifest)')"
           Code="LAMSDK0022"
           Text="There is no image to run on $(_LamellaRunDeviceId): no manifest at '$(_LamellaRunManifest)'. A run on a debug probe publishes the program and runs the image it writes, and a run with the no-build option publishes nothing; run without it." />
  </Target>

  <Target Name="_LamellaRhuEmulatorRoute" Condition="'$(_LamellaRunRoute)' == 'emulator'">
    <PropertyGroup>
      <LamellaDeviceRoute>emulator</LamellaDeviceRoute>
      <LamellaEmulatorMachine>$(_LamellaRunMachine)</LamellaEmulatorMachine>
    </PropertyGroup>
  </Target>

  <!-- The runtime supplies the introduction on both RHU routes, so the tool omits its own banner.
       The run on an emulator gives the tool the executable Lamella RHU composed, the device
       and its board, and after the bare double dash RHU's arguments as RHU wrote
       them. What dotnet run appends for the program then follows RHU's arguments, as it would have had dotnet run
       started RHU's command itself, and the run stays in the folder RHU names. The tool starts RHU's executable with
       exactly those arguments, and the run ends with the emulator's exit code. An executable's name that is quoted
       already, or has blanks around it, is taken as dotnet run takes one: without them. -->
  <Target Name="_LamellaRhuEmulatorRun" DependsOnTargets="_LamellaCheckTool;_LamellaRhuEmulatorRoute;RhuComputeRunCommand" Condition="'$(_LamellaRunRoute)' == 'emulator'">
    <PropertyGroup>
      <_LamellaRhuEmulator>$([System.String]::Copy('$(RunCommand)').Trim().Trim('"'))</_LamellaRhuEmulator>
      <_LamellaRhuEmulatorArguments>$(RunArguments)</_LamellaRhuEmulatorArguments>
      <RunCommand>$(_LamellaTool)</RunCommand>
      <RunArguments>run --emulator &quot;$(_LamellaRhuEmulator)&quot; --device &quot;$(_LamellaRunDeviceId)&quot; --board &quot;$(_LamellaRunBoard)&quot; --no-banner -- $(_LamellaRhuEmulatorArguments)</RunArguments>
    </PropertyGroup>
  </Target>

</Project>
