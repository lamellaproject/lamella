<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Lamella.Sdk</id>
    <version>$version$</version>
    <!-- Packing writes here what every package carries: authors, license, licenseUrl, projectUrl, copyright and repository. -->
    <description>The MSBuild project SDK for building, publishing and running C# programs on Lamella and Lamella RHU boards. lamella1.0 targets Lamella; net11.0 targets Lamella RHU.</description>
    <readme>README.md</readme>
    <packageTypes>
      <packageType name="MSBuildSdk" />
    </packageTypes>
  </metadata>
</package>
